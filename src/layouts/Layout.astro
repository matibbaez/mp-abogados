---
import { ViewTransitions } from 'astro:transitions';
import Loader from '../components/Loader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

interface Props {
    title: string;
    description?: string; // Agregamos la descripción como prop opcional para SEO
    hideNav?: boolean; 
}

const { 
    title, 
    // Descripción por defecto ultra optimizada para Google
    description = "Estudio jurídico especializado en accidentes de tránsito. Reclamamos los daños de tu vehículo y lesiones físicas. Sin adelantos de honorarios. Consulta sin cargo.",
    hideNav = false 
} = Astro.props;

// Generamos la URL canónica para evitar penalizaciones de contenido duplicado en Google
const canonicalURL = new URL(Astro.url.pathname, 'https://www.myp-abogados.com.ar');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        
        <!-- SEO y Meta Tags -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        
        <!-- Open Graph / Redes Sociales y WhatsApp -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="https://www.myp-abogados.com.ar/og-image.jpg" />
        
        <meta name="generator" content={Astro.generator} />
        
        <!-- Transiciones fluidas entre páginas -->
        <ViewTransitions />
    </head>
    <body class="bg-slate-950 text-slate-100 antialiased selection:bg-slate-800 selection:text-white pt-0">
        
        <!-- Loader Premium de carga inicial -->
        <Loader />

        <!-- Renderizado condicional: Solo se muestra si hideNav es false -->
        {!hideNav && <Navbar />}
        
        <slot />
        
        <!-- Renderizado condicional: Ocultamos el footer y el botón flotante en landing pages -->
        {!hideNav && (
            <>
                <Footer />
                <WhatsAppFloat />
            </>
        )}

        <!-- LA OPCIÓN NUCLEAR: Bypasseamos npm y Astro -->
        <!-- 1. Cargamos el motor de Lenis directo desde el CDN -->
        <script is:inline src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

        <!-- 2. Inicializamos con is:inline para que funcione perfecto con ViewTransitions -->
        <script is:inline>
            let lenis;

            document.addEventListener('astro:page-load', () => {
                // Si ya existe de la página anterior, lo matamos para no duplicar
                if (lenis) {
                    lenis.destroy();
                }

                // Iniciamos la nueva instancia usando window.Lenis (del CDN)
                lenis = new window.Lenis({
                    duration: 1.2,
                    smoothWheel: true
                });

                function raf(time) {
                    lenis.raf(time);
                    requestAnimationFrame(raf);
                }

                requestAnimationFrame(raf);
            });
        </script>
    </body>
</html>