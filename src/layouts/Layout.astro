---
import { ViewTransitions } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="MP Abogados - Asesoría Legal de Alta Gama." />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <ViewTransitions />
    </head>
    <body class="bg-slate-950 text-slate-100 antialiased selection:bg-slate-800 selection:text-white pt-0">
        
        <Navbar />
        <slot />
        <Footer />
        <WhatsAppFloat />

        <!-- LA OPCIÓN NUCLEAR: Bypasseamos npm y Astro -->
        <!-- 1. Cargamos el motor de Lenis directo desde el CDN -->
        <script is:inline src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

        <!-- 2. Inicializamos con is:inline para que funcione perfecto con ViewTransitions -->
        <script is:inline>
            let lenis;

            document.addEventListener('astro:page-load', () => {
                // Si ya existe de la página anterior, lo matamos para no duplicar
                if (lenis) {
                    lenis.destroy();
                }

                // Iniciamos la nueva instancia usando window.Lenis (del CDN)
                lenis = new window.Lenis({
                    duration: 1.2,
                    smoothWheel: true
                });

                function raf(time) {
                    lenis.raf(time);
                    requestAnimationFrame(raf);
                }

                requestAnimationFrame(raf);
            });
        </script>
    </body>
</html>