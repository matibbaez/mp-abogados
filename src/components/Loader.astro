---
// src/components/Loader.astro
---
<!-- Loader Container -->
<div id="mp-loader" class="fixed inset-0 z-[9999] bg-slate-950 flex items-center justify-center transition-all duration-1000 ease-in-out">
    
    <div class="transform scale-110 md:scale-125">
        <!-- Logo SVG Animado -->
        <svg class="w-20 h-16 shadow-2xl rounded-sm overflow-hidden" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="mp-grad-loader" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#1e3a8a" />
                    <stop offset="100%" stop-color="#0f172a" />
                </linearGradient>
            </defs>
            
            <!-- Fondos que se expanden -->
            <g class="bg-reveal" style="transform-origin: 60px 50px;">
                <rect x="0" y="0" width="60" height="100" fill="#ffffff"/>
                <rect x="60" y="0" width="60" height="100" fill="url(#mp-grad-loader)"/>
            </g>
            
            <!-- Trazos que se dibujan -->
            <polyline class="draw-stroke" pathLength="100" points="16,70 16,32 30,48 44,32 44,70" fill="none" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
            <path class="draw-stroke" pathLength="100" d="M 78 70 L 78 32 L 88 32 A 12 12 0 0 1 88 56 L 78 56" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
        </svg>
    </div>

</div>

<style>
    /* Estado inicial para evitar parpadeos antes de que empiece la animación */
    .bg-reveal {
        transform: scaleX(0);
        animation: scaleXReveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }

    .draw-stroke {
        stroke-dasharray: 100;
        stroke-dashoffset: 100;
        /* Empieza a dibujarse al segundo 0.8 */
        animation: drawLine 1.5s cubic-bezier(0.65, 0, 0.35, 1) 0.8s forwards;
    }

    @keyframes scaleXReveal {
        0% { transform: scaleX(0); }
        100% { transform: scaleX(1); }
    }

    @keyframes drawLine {
        0% { stroke-dashoffset: 100; }
        100% { stroke-dashoffset: 0; }
    }
</style>

<script is:inline>
    // Apenas lee el script, bloquea el scroll SIEMPRE
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';

    document.addEventListener('astro:page-load', () => {
        const loader = document.getElementById('mp-loader');
        if (!loader) {
            // Failsafe por si el loader no existe, liberamos el scroll
            document.documentElement.style.overflow = '';
            document.body.style.overflow = '';
            return;
        }
        
        // Temporizador: 2.6 segundos (sin el texto la animación termina antes)
        setTimeout(() => {
            // Efecto de salida: Se desvanece y hace zoom hacia adelante
            loader.classList.add('opacity-0', 'scale-110', 'pointer-events-none');
            
            // Libera el scroll para que el usuario pueda navegar
            document.documentElement.style.overflow = '';
            document.body.style.overflow = '';
            
            // Remueve el nodo HTML para que no estorbe en el DOM
            setTimeout(() => {
                loader.remove();
            }, 1000); 
            
        }, 2600); 
    });
</script>