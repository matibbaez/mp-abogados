---
// src/components/FAQ.astro
const faqs = [
  {
    question: "¿Tengo que pagar para empezar?",
    answer: "No pedimos adelantos de honorarios. Antes de comenzar, te explicamos cómo trabajamos y cómo se calculan nuestros honorarios, que se abonan únicamente cuando cobrás."
  },
  {
    question: "¿Puedo consultar si todavía no tengo toda la documentación?",
    answer: "Sí. Podemos orientarte desde el primer contacto y ayudarte a organizar lo que necesitás. No hace falta que tengas todo resuelto para escribirnos."
  },
  {
    question: "¿Tengo que aceptar la oferta de la aseguradora?",
    answer: "La decisión siempre es tuya. Te explicamos el ofrecimiento en detalle y te asesoramos para que puedas decidir con información clara y precisa."
  },
  {
    question: "¿Cuánto puede tardar el reclamo?",
    answer: "Los tiempos dependen de las características del caso y de la respuesta de la aseguradora. Te mantenemos informado sobre los avances en cada etapa."
  },
  {
    question: "¿Atienden casos de todo el país?",
    answer: "Sí, trabajamos con casos de toda la Argentina. Consultanos cómo podemos acompañarte según dónde ocurrió el accidente."
  },
  {
    question: "¿Tengo que ir personalmente al estudio?",
    answer: "En la mayoría de los casos no es necesario: podemos gestionar tu reclamo a distancia."
  }
];
---

<section id="faq" class="py-24 md:py-32 px-6 lg:px-8 bg-slate-50 text-slate-950 relative overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">
            
            <div class="w-full lg:w-5/12 reveal-faq">
                <div class="lg:sticky lg:top-32">
                    <div class="inline-flex items-center space-x-3 mb-6">
                        <span class="w-8 h-px bg-accent"></span>
                        <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-slate-500">Respuestas Claras</span>
                    </div>
                    <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif leading-[1.05] tracking-tighter mb-8">
                        Preguntas <br/>
                        <span class="text-slate-400 italic font-light">frecuentes.</span>
                    </h2>
                    <p class="text-slate-500 font-light text-sm md:text-base leading-relaxed mb-10 max-w-md">
                        Sabemos que un siniestro vial genera muchísima incertidumbre. Resolvemos tus dudas principales con total transparencia antes de que tomes una decisión.
                    </p>
                </div>
            </div>

            <div class="w-full lg:w-7/12 reveal-faq" style="transition-delay: 150ms;">
                <div class="border-t border-slate-200">
                    {faqs.map((faq) => (
                        <div class="faq-item group border-b border-slate-200 overflow-hidden">
                            <button class="faq-button w-full flex items-center justify-between py-6 md:py-8 text-left focus:outline-none">
                                <h3 class="text-lg md:text-xl font-bold text-slate-900 transition-colors duration-300 pr-8 group-hover:text-accent group-[.active]:text-accent leading-snug">
                                    {faq.question}
                                </h3>
                                <div class="relative w-6 h-6 shrink-0 flex items-center justify-center">
                                    <span class="absolute w-full h-0.5 bg-slate-400 transition-colors duration-300 group-hover:bg-accent group-[.active]:bg-accent"></span>
                                    <span class="absolute w-full h-0.5 bg-slate-400 transition-all duration-500 transform rotate-90 group-hover:bg-accent group-[.active]:bg-accent group-[.active]:rotate-0"></span>
                                </div>
                            </button>
                            <div class="faq-content h-0 opacity-0 transition-all duration-500 ease-in-out">
                                <p class="text-slate-500 font-light text-sm md:text-base leading-relaxed pb-8 md:pb-10 pr-4 md:pr-12">
                                    {faq.answer}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .reveal-faq { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
    .reveal-faq.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.reveal-faq').forEach(el => observer.observe(el));

        document.querySelectorAll('.faq-item').forEach(item => {
            const button = item.querySelector('.faq-button');
            const content = item.querySelector('.faq-content') as HTMLElement;
            if (!button || !content) return;

            button.addEventListener('click', () => {
                const isActive = item.classList.contains('active');
                document.querySelectorAll('.faq-item').forEach(other => {
                    if (other !== item) {
                        other.classList.remove('active');
                        const otherContent = other.querySelector('.faq-content') as HTMLElement;
                        if (otherContent) { otherContent.style.height = '0px'; otherContent.style.opacity = '0'; }
                    }
                });
                if (!isActive) {
                    item.classList.add('active');
                    content.style.height = content.scrollHeight + 'px';
                    content.style.opacity = '1';
                } else {
                    item.classList.remove('active');
                    content.style.height = '0px';
                    content.style.opacity = '0';
                }
            });
        });
    });
</script>