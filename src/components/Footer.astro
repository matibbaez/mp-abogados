---
---
<footer class="bg-slate-950 pt-24 md:pt-32 pb-8 px-6 lg:px-8 border-t border-slate-900 overflow-hidden relative">
    
    <!-- Elemento decorativo de fondo sutil -->
    <div class="absolute top-0 right-0 w-1/2 h-[500px] bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-900/40 via-transparent to-transparent pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        
        <!-- Titular de Cierre Editorial -->
        <div class="mb-20 md:mb-32">
            <h2 class="text-5xl md:text-7xl lg:text-[6rem] font-serif font-bold text-white leading-[0.9] tracking-tighter mb-8">
                Defensa legal <br/>
                <span class="text-slate-500 italic font-light">intransigente.</span>
            </h2>
            <a href="#contacto" class="inline-flex items-center space-x-4 text-slate-300 hover:text-white transition-colors duration-300 group">
                <span class="text-xs md:text-sm font-bold tracking-[0.2em] uppercase">Iniciar Reclamo Hoy</span>
                <span class="w-12 h-[1px] bg-slate-600 group-hover:w-16 group-hover:bg-white transition-all duration-500"></span>
            </a>
        </div>

        <!-- Grilla de Información Asimétrica -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-8 border-t border-slate-800/60 pt-16 mb-24">
            
            <!-- Marca y Dirección (Ocupa 4 columnas) -->
            <div class="md:col-span-4 lg:col-span-4 flex flex-col">
                <div class="flex items-center gap-4 md:gap-5 mb-8">
                    
                    <!-- Emblema SVG Dibujado Footer -->
                    <svg class="w-16 h-14 md:w-20 md:h-16 shadow-2xl rounded-sm overflow-hidden" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="mp-grad-foot" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#1e3a8a" />
                                <stop offset="100%" stop-color="#0f172a" />
                            </linearGradient>
                        </defs>
                        <rect x="0" y="0" width="60" height="100" fill="#ffffff"/>
                        <rect x="60" y="0" width="60" height="100" fill="url(#mp-grad-foot)"/>
                        
                        <!-- Isotipo M (Vector) -->
                        <polyline points="16,70 16,32 30,48 44,32 44,70" fill="none" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                        
                        <!-- Isotipo P (Vector) -->
                        <path d="M 78 70 L 78 32 L 88 32 A 12 12 0 0 1 88 56 L 78 56" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                    </svg>
                    
                    <!-- Textos acompañantes -->
                    <div class="flex flex-col pl-1 md:pl-2">
                        <span class="text-xl md:text-2xl font-bold font-serif tracking-[0.25em] text-white uppercase leading-none mb-1.5 md:mb-2">
                            Abogados
                        </span>
                        <span class="text-[0.65rem] md:text-xs tracking-[0.35em] text-slate-500 font-sans font-semibold uppercase leading-none">
                            Estudio Jurídico
                        </span>
                    </div>
                </div>
                
                <p class="text-sm text-slate-400 font-light leading-relaxed max-w-xs mb-6">
                    Atención presencial exclusiva con cita previa para garantizar absoluta confidencialidad.
                </p>
                <p class="text-sm text-slate-500 font-serif">
                    Buenos Aires, Argentina.
                </p>
            </div>

            <!-- Navegación (Ocupa 3 columnas) -->
            <div class="md:col-span-4 lg:col-span-3">
                <h4 class="text-white text-[10px] font-bold tracking-[0.3em] uppercase mb-8">Índice</h4>
                <ul class="space-y-5">
                    <li><a href="#servicios" class="text-sm text-slate-400 hover:text-white transition-colors duration-300 relative group inline-flex items-center">
                        <span class="w-0 h-[1px] bg-white mr-0 group-hover:w-3 group-hover:mr-3 transition-all duration-300"></span>
                        Nuestra Especialidad
                    </a></li>
                    <li><a href="#estudio" class="text-sm text-slate-400 hover:text-white transition-colors duration-300 relative group inline-flex items-center">
                        <span class="w-0 h-[1px] bg-white mr-0 group-hover:w-3 group-hover:mr-3 transition-all duration-300"></span>
                        Filosofía de la Firma
                    </a></li>
                    <li><a href="#contacto" class="text-sm text-slate-400 hover:text-white transition-colors duration-300 relative group inline-flex items-center">
                        <span class="w-0 h-[1px] bg-white mr-0 group-hover:w-3 group-hover:mr-3 transition-all duration-300"></span>
                        Evaluación de Caso
                    </a></li>
                </ul>
            </div>

            <!-- Contacto Directo (Ocupa 5 columnas) -->
            <div class="md:col-span-4 lg:col-span-5">
                <h4 class="text-white text-[10px] font-bold tracking-[0.3em] uppercase mb-8">Contacto</h4>
                <div class="flex flex-col gap-6">
                    <a href="tel:+54111500000000" class="group flex items-start gap-4">
                        <svg class="w-5 h-5 text-slate-600 group-hover:text-white transition-colors mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        <div>
                            <div class="text-[9px] text-slate-500 uppercase tracking-[0.2em] font-bold mb-1">Línea de Urgencias</div>
                            <div class="text-lg md:text-xl text-slate-300 group-hover:text-white font-serif transition-colors">+54 (11) 15-XXXX-XXXX</div>
                        </div>
                    </a>
                    
                    <a href="mailto:contacto@mpabogados.com.ar" class="group flex items-start gap-4">
                        <svg class="w-5 h-5 text-slate-600 group-hover:text-white transition-colors mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <div>
                            <div class="text-[9px] text-slate-500 uppercase tracking-[0.2em] font-bold mb-1">Email Institucional</div>
                            <div class="text-lg md:text-xl text-slate-300 group-hover:text-white font-serif transition-colors">contacto@mpabogados.com.ar</div>
                        </div>
                    </a>
                </div>
                
                <!-- Instagram -->
                <div class="mt-8 pt-8 border-t border-slate-800/60">
                    <a href="https://instagram.com/abogados.transitomp" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 text-slate-400 hover:text-white transition-colors group">
                        <div class="w-10 h-10 border border-slate-800 flex items-center justify-center rounded-sm group-hover:border-slate-600 transition-colors">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        </div>
                        <span class="text-[10px] uppercase tracking-[0.2em] font-bold">@abogados.transitomp</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Fila Inferior: Créditos -->
        <div class="pt-8 border-t border-slate-900 flex flex-col lg:flex-row justify-between items-center gap-6">
            <p class="text-[10px] text-slate-600 uppercase tracking-widest font-bold text-center lg:text-left">
                &copy; {new Date().getFullYear()} MP Abogados. Todos los derechos reservados.
            </p>
            
            <!-- Firma de Agencia -->
            <p class="text-[9px] text-slate-600 tracking-[0.3em] uppercase font-bold text-center lg:text-right flex items-center justify-center lg:justify-end gap-2">
                Digital Experience by 
                <a href="#" class="inline-flex items-center text-slate-400 hover:text-white transition-colors duration-300 relative group">
                    <span class="relative z-10">VisionPath</span>
                    <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full"></span>
                </a>
            </p>
        </div>
    </div>
</footer>