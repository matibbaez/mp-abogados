---
---
<nav id="navbar" class="fixed w-full top-0 z-50 transition-all duration-500 bg-transparent border-b border-transparent">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 md:h-24">
            
            <!-- Logo Premium: Sello Vectorial Geométrico -->
            <a href="#" class="relative z-[60] flex items-center gap-3 md:gap-4 group">
                
                <!-- Emblema SVG Dibujado -->
                <svg class="w-12 h-10 md:w-[3.25rem] md:h-12 shadow-2xl transition-transform duration-500 group-hover:scale-105 rounded-sm overflow-hidden" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="mp-grad-nav" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#1e3a8a" />
                            <stop offset="100%" stop-color="#0f172a" />
                        </linearGradient>
                    </defs>
                    <rect x="0" y="0" width="60" height="100" fill="#ffffff"/>
                    <rect x="60" y="0" width="60" height="100" fill="url(#mp-grad-nav)"/>
                    
                    <!-- Isotipo M (Vector) -->
                    <polyline points="16,70 16,32 30,48 44,32 44,70" fill="none" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                    
                    <!-- Isotipo P (Vector) -->
                    <path d="M 78 70 L 78 32 L 88 32 A 12 12 0 0 1 88 56 L 78 56" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
                
                <!-- Textos acompañantes -->
                <div class="flex flex-col pl-1">
                    <span class="text-base md:text-lg font-bold font-serif tracking-[0.25em] text-white uppercase leading-none mb-1.5">
                        Abogados
                    </span>
                    <span class="text-[0.55rem] md:text-[0.65rem] tracking-[0.35em] text-slate-300 font-sans font-semibold uppercase leading-none transition-colors duration-300" id="logo-subtitle">
                        Estudio Jurídico
                    </span>
                </div>
            </a>
            
            <!-- Menú Desktop -->
            <div class="hidden md:flex items-center space-x-8 lg:space-x-10">
                <a href="#servicios" class="relative text-sm font-medium text-slate-200 hover:text-white transition-colors duration-300 group py-2">
                    Áreas de Práctica
                    <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full"></span>
                </a>
                <a href="#estudio" class="relative text-sm font-medium text-slate-200 hover:text-white transition-colors duration-300 group py-2">
                    El Estudio
                    <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full"></span>
                </a>
                
                <!-- Botón CTA Simple y Minimalista -->
                <!-- <a href="#contacto" class="ml-4 px-7 py-3 border border-white/40 text-white hover:bg-white hover:text-slate-950 transition-colors duration-300 rounded-sm text-[10px] font-bold tracking-[0.2em] uppercase">
                    Consulta Gratuita
                </a> -->
            </div>

            <!-- Botón Menú Mobile (Hamburguesa Absoluta e Infalible) -->
            <button id="mobile-menu-btn" class="md:hidden relative z-[60] w-12 h-12 focus:outline-none flex justify-center items-center group">
                <div class="relative w-7 h-[14px]">
                    <span id="line-1" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-0"></span>
                    <span id="line-2" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-[6px]"></span>
                    <span id="line-3" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-[12px]"></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Menú Mobile Fullscreen Overlay -->
    <div id="mobile-menu" class="fixed top-0 left-0 w-full h-[100dvh] bg-slate-950/95 backdrop-blur-2xl z-40 flex flex-col justify-center items-center opacity-0 pointer-events-none transition-opacity duration-500">
        <div class="flex flex-col items-center gap-8 md:gap-10 text-center w-full px-6">
            <a href="#servicios" class="mobile-link text-3xl font-serif text-slate-300 hover:text-white transition-all duration-300 opacity-0 translate-y-4">
                Áreas de Práctica
            </a>
            <a href="#estudio" class="mobile-link text-3xl font-serif text-slate-300 hover:text-white transition-all duration-300 opacity-0 translate-y-4">
                El Estudio
            </a>
            <div class="w-12 h-[1px] bg-slate-800 my-4 opacity-0 translate-y-4 mobile-link"></div>
            
            <!-- Botón CTA Mobile Simple -->
            <a href="#contacto" class="mobile-link flex items-center justify-center w-full max-w-xs px-8 py-4 border border-slate-700 bg-transparent text-white hover:bg-white hover:text-slate-950 transition-colors duration-300 rounded-sm text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase opacity-0 translate-y-4">
                Consulta Gratuita
            </a>
        </div>
    </div>
</nav>

<script>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const line1 = document.getElementById('line-1');
        const line2 = document.getElementById('line-2');
        const line3 = document.getElementById('line-3');
        const links = document.querySelectorAll('.mobile-link');
        const navbar = document.getElementById('navbar');
        const logoSubtitle = document.getElementById('logo-subtitle');

        let isMenuOpen = false;

        const updateNavbarStyle = () => {
            if (window.scrollY > 50 || isMenuOpen) {
                navbar?.classList.remove('bg-transparent', 'border-transparent');
                navbar?.classList.add('bg-slate-950/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-xl');
                logoSubtitle?.classList.replace('text-slate-300', 'text-slate-400');
            } else {
                navbar?.classList.add('bg-transparent', 'border-transparent');
                navbar?.classList.remove('bg-slate-950/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-xl');
                logoSubtitle?.classList.replace('text-slate-400', 'text-slate-300');
            }
        };

        window.addEventListener('scroll', updateNavbarStyle);
        updateNavbarStyle(); 

        const toggleMenu = () => {
            isMenuOpen = !isMenuOpen;
            
            updateNavbarStyle(); 
            
            if (isMenuOpen) {
                menu?.classList.remove('opacity-0', 'pointer-events-none');
                menu?.classList.add('opacity-100', 'pointer-events-auto');
                
                line1?.classList.remove('top-0');
                line1?.classList.add('top-[6px]', 'rotate-45');
                
                line2?.classList.add('opacity-0', 'translate-x-4');
                
                line3?.classList.remove('top-[12px]');
                line3?.classList.add('top-[6px]', '-rotate-45');
                
                links.forEach((link, index) => {
                    setTimeout(() => {
                        link.classList.remove('opacity-0', 'translate-y-4');
                        link.classList.add('opacity-100', 'translate-y-0');
                    }, 150 + (index * 100));
                });
                
                document.body.style.overflow = 'hidden';
            } else {
                menu?.classList.remove('opacity-100', 'pointer-events-auto');
                menu?.classList.add('opacity-0', 'pointer-events-none');
                
                line1?.classList.remove('top-[6px]', 'rotate-45');
                line1?.classList.add('top-0');
                
                line2?.classList.remove('opacity-0', 'translate-x-4');
                
                line3?.classList.remove('top-[6px]', '-rotate-45');
                line3?.classList.add('top-[12px]');
                
                links.forEach((link) => {
                    link.classList.remove('opacity-100', 'translate-y-0');
                    link.classList.add('opacity-0', 'translate-y-4');
                });
                
                document.body.style.overflow = '';
            }
        };

        btn?.replaceWith(btn.cloneNode(true));
        const newBtn = document.getElementById('mobile-menu-btn');
        newBtn?.addEventListener('click', toggleMenu);

        links.forEach(link => {
            link.addEventListener('click', () => {
                if(isMenuOpen) toggleMenu();
            });
        });
    });
</script>