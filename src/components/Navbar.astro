---
---
<nav id="navbar" class="fixed w-full top-0 z-50 transition-all duration-500 bg-transparent border-b border-transparent">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 md:h-24">
            
            <!-- Logo Premium: Sello Vectorial Geométrico -->
            <a href="#" class="relative z-[60] flex items-center gap-3 md:gap-4 group">
                
                <svg class="w-12 h-10 md:w-[3.25rem] md:h-12 shadow-2xl transition-transform duration-500 group-hover:scale-105 rounded-sm overflow-hidden" viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="mp-grad-nav" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#1e3a8a" />
                            <stop offset="100%" stop-color="#0f172a" />
                        </linearGradient>
                    </defs>
                    <rect x="0" y="0" width="60" height="100" fill="#ffffff"/>
                    <rect x="60" y="0" width="60" height="100" fill="url(#mp-grad-nav)"/>
                    
                    <polyline points="16,70 16,32 30,48 44,32 44,70" fill="none" stroke="#0f172a" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                    
                    <path d="M 78 70 L 78 32 L 88 32 A 12 12 0 0 1 88 56 L 78 56" fill="none" stroke="#ffffff" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round"/>
                </svg>
                
                <!-- Textos acompañantes -->
                <div class="flex flex-col pl-1">
                    <span class="text-base md:text-lg font-bold font-serif tracking-[0.25em] text-white uppercase leading-none mb-1.5">
                        Abogados
                    </span>
                    <span class="text-[0.55rem] md:text-[0.65rem] tracking-[0.35em] text-slate-300 font-sans font-semibold uppercase leading-none transition-colors duration-300" id="logo-subtitle">
                        Estudio Jurídico
                    </span>
                </div>
            </a>
            
            <!-- Menú Desktop -->
            <div class="hidden md:flex items-center space-x-8 lg:space-x-10">
                <a href="#servicios" class="relative text-sm font-medium text-slate-200 hover:text-white transition-colors duration-300 group py-2">
                    Áreas de Práctica
                    <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full"></span>
                </a>
                <a href="#estudio" class="relative text-sm font-medium text-slate-200 hover:text-white transition-colors duration-300 group py-2">
                    El Estudio
                    <span class="absolute bottom-0 left-0 w-0 h-[1px] bg-white transition-all duration-300 group-hover:w-full"></span>
                </a>
            </div>

            <!-- Botón Menú Mobile (Hamburguesa animada) -->
            <button id="mobile-menu-btn" class="md:hidden relative z-[60] w-12 h-12 focus:outline-none flex justify-center items-center group">
                <div class="relative w-7 h-[14px]">
                    <span id="line-1" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-0"></span>
                    <span id="line-2" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-[6px]"></span>
                    <span id="line-3" class="absolute left-0 w-7 h-[2px] bg-white rounded-full transition-all duration-300 top-[12px]"></span>
                </div>
            </button>
        </div>
    </div>

    <!-- Menú Mobile Fullscreen Overlay (Premium Editorial) -->
    <div id="mobile-menu" class="fixed top-0 left-0 w-full h-[100dvh] bg-slate-950/98 backdrop-blur-3xl z-40 flex flex-col justify-between px-8 pt-32 pb-12 opacity-0 pointer-events-none transition-opacity duration-500">
        
        <!-- Glow sutil de fondo para profundidad -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,_var(--tw-gradient-stops))] from-blue-900/10 via-slate-950/0 to-transparent pointer-events-none z-0"></div>

        <!-- Links Principales (Alineados a la izquierda) -->
        <div class="flex flex-col items-start gap-8 w-full relative z-10 mt-4">
            <a href="#servicios" class="mobile-link group flex flex-col opacity-0 -translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] delay-100">
                <span class="text-[10px] text-slate-500 tracking-[0.2em] font-sans uppercase mb-1 font-bold">01</span>
                <span class="text-4xl sm:text-5xl font-serif text-white group-hover:text-slate-400 transition-colors duration-300">Áreas de Práctica</span>
            </a>
            
            <a href="#estudio" class="mobile-link group flex flex-col opacity-0 -translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] delay-200">
                <span class="text-[10px] text-slate-500 tracking-[0.2em] font-sans uppercase mb-1 font-bold">02</span>
                <span class="text-4xl sm:text-5xl font-serif text-white group-hover:text-slate-400 transition-colors duration-300">El Estudio</span>
            </a>

            <a href="#resultados" class="mobile-link group flex flex-col opacity-0 -translate-x-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] delay-300">
                <span class="text-[10px] text-slate-500 tracking-[0.2em] font-sans uppercase mb-1 font-bold">03</span>
                <span class="text-4xl sm:text-5xl font-serif text-white group-hover:text-slate-400 transition-colors duration-300">Resultados</span>
            </a>
        </div>

        <!-- Bloque de Contacto Inferior -->
        <div class="mobile-footer w-full relative z-10 flex flex-col gap-8 opacity-0 translate-y-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] delay-400">
            
            <div class="w-full h-[1px] bg-slate-800"></div>

            <div class="flex flex-col gap-2">
                <span class="text-[9px] text-slate-500 uppercase tracking-widest font-bold">Línea Directa de Urgencias</span>
                <a href="tel:+54111500000000" class="text-xl font-serif text-slate-200">+54 (11) 15-XXXX-XXXX</a>
            </div>

            <a href="#contacto" class="mobile-link-close flex items-center justify-center w-full px-8 py-5 bg-white text-slate-950 hover:bg-slate-200 transition-colors duration-300 rounded-sm text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase">
                Consulta Sin Cargo
            </a>
        </div>
    </div>
</nav>

<script>
    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const links = document.querySelectorAll('.mobile-link, .mobile-link-close');
        const mobileFooter = document.querySelector('.mobile-footer');
        const navbar = document.getElementById('navbar');
        const logoSubtitle = document.getElementById('logo-subtitle');

        if(!btn || !menu) return;

        let isMenuOpen = false;

        const updateNavbarStyle = () => {
            if (window.scrollY > 50 || isMenuOpen) {
                navbar?.classList.remove('bg-transparent', 'border-transparent');
                navbar?.classList.add('bg-slate-950/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-xl');
                logoSubtitle?.classList.replace('text-slate-300', 'text-slate-400');
            } else {
                navbar?.classList.add('bg-transparent', 'border-transparent');
                navbar?.classList.remove('bg-slate-950/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-xl');
                logoSubtitle?.classList.replace('text-slate-400', 'text-slate-300');
            }
        };

        window.addEventListener('scroll', updateNavbarStyle);
        updateNavbarStyle(); 

        const toggleMenu = () => {
            isMenuOpen = !isMenuOpen;
            
            updateNavbarStyle(); 
            
            const line1 = document.getElementById('line-1');
            const line2 = document.getElementById('line-2');
            const line3 = document.getElementById('line-3');
            
            if (isMenuOpen) {
                menu?.classList.remove('opacity-0', 'pointer-events-none');
                menu?.classList.add('opacity-100', 'pointer-events-auto');
                
                // Animación a Cruz (X)
                line1?.classList.remove('top-0');
                line1?.classList.add('top-[6px]', 'rotate-45');
                
                line2?.classList.add('opacity-0', 'translate-x-4');
                
                line3?.classList.remove('top-[12px]');
                line3?.classList.add('top-[6px]', '-rotate-45');
                
                // Entran los links desde la izquierda
                document.querySelectorAll('.mobile-link').forEach((link) => {
                    link.classList.remove('opacity-0', '-translate-x-8');
                    link.classList.add('opacity-100', 'translate-x-0');
                });

                // Entra el footer desde abajo
                mobileFooter?.classList.remove('opacity-0', 'translate-y-8');
                mobileFooter?.classList.add('opacity-100', 'translate-y-0');
                
                document.body.style.overflow = 'hidden';
            } else {
                menu?.classList.remove('opacity-100', 'pointer-events-auto');
                menu?.classList.add('opacity-0', 'pointer-events-none');
                
                // Vuelve a Hamburguesa
                line1?.classList.remove('top-[6px]', 'rotate-45');
                line1?.classList.add('top-0');
                
                line2?.classList.remove('opacity-0', 'translate-x-4');
                
                line3?.classList.remove('top-[6px]', '-rotate-45');
                line3?.classList.add('top-[12px]');
                
                // Salen los links
                document.querySelectorAll('.mobile-link').forEach((link) => {
                    link.classList.remove('opacity-100', 'translate-x-0');
                    link.classList.add('opacity-0', '-translate-x-8');
                });

                // Sale el footer
                mobileFooter?.classList.remove('opacity-100', 'translate-y-0');
                mobileFooter?.classList.add('opacity-0', 'translate-y-8');
                
                document.body.style.overflow = '';
            }
        };

        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener('click', toggleMenu);

        // Los links cierran el menú (incluyendo el botón CTA)
        links.forEach(link => {
            link.addEventListener('click', () => {
                if(isMenuOpen) toggleMenu();
            });
        });
    });
</script>