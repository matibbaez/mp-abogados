---
const whatsappUrl = "https://wa.me/5491168809555";
---
<!-- El mx-6 asegura que en celulares siempre tenga margen lateral y no toque los bordes -->
<div class="mx-6 md:mx-auto max-w-4xl bg-slate-900 border border-slate-800 p-8 md:p-12 rounded-lg text-center my-16 md:my-24 shadow-2xl relative overflow-hidden reveal-cta">
    
    <!-- Brillo sutil de fondo -->
    <div class="absolute inset-0 bg-gradient-to-b from-accent/10 to-transparent pointer-events-none"></div>
    
    <h3 class="text-3xl md:text-4xl font-serif font-bold text-white mb-4 relative z-10 leading-tight">
        ¿Tuviste un accidente? <br class="sm:hidden"/> Contanos qué pasó.
    </h3>
    
    <p class="text-slate-400 font-light text-sm md:text-base leading-relaxed mb-8 max-w-2xl mx-auto relative z-10 px-2 md:px-0">
        Te explicamos cómo podemos ayudarte y qué documentación necesitás para empezar. Consulta inicial sin cargo y sin adelantos de honorarios.
    </p>
    
    <!-- El botón ahora es w-full en mobile para que quede ancho y simétrico, y w-auto en desktop -->
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-3 bg-accent text-white px-6 md:px-8 py-4 md:py-5 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] rounded-sm hover:bg-blue-600 transition-colors relative z-10 w-full sm:w-auto shadow-lg shadow-accent/20">
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        <span class="text-center">Consultar mi caso</span>
    </a>
</div>

<style>
    .reveal-cta {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .reveal-cta.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.reveal-cta').forEach(el => observer.observe(el));
    });
</script>