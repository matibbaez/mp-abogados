            </div>

            <div class="p-6 md:p-8 overflow-y-auto space-y-6">
                {modalTestimonials.map((testimonio) => (
                    <div class="bg-slate-950/50 border border-slate-800 p-6 md:p-8 rounded-sm">
                        <div class="flex justify-between items-start mb-4">
