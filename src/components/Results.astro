                                <div class="font-serif font-bold text-lg text-white">{testimonio.client}</div>
                                <div class="text-[9px] font-bold tracking-[0.2em] text-slate-500 uppercase mt-1">
                                    {testimonio.tag}
                                </div>
                            </div>
                            <div class="flex flex-col items-end gap-2">
                                <div class="flex gap-0.5" set:html={renderStars(testimonio.rating)} />
                                <span class="text-[10px] text-slate-500 uppercase tracking-widest">
                                    {testimonio.date}
                                </span>
                            </div>
                        </div>
                        <p class="text-slate-300 text-sm font-light leading-relaxed italic">
                            "{testimonio.quote}"
                        </p>
                    </div>
                ))}
            </div>
            
            <div class="p-6 border-t border-slate-800 bg-slate-950 text-center">
                <!-- Se cambió el enlace para que abra WhatsApp en una pestaña nueva -->
                <a href="https://wa.me/5491168809555?text=Hola,%20estuve%20leyendo%20los%20casos%20de%20%C3%A9xito%20y%20me%20gustar%C3%ADa%20que%20eval%C3%BAen%20mi%20caso%20gratis." target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center bg-accent text-white px-8 py-4 text-[10px] md:text-xs font-bold uppercase tracking-[0.2em] rounded-sm hover:bg-blue-600 transition-colors">
                    Evaluar mi caso gratis
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .reveal-results { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
    .reveal-results.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.reveal-results').forEach(el => observer.observe(el));

        const btnOpenDesktop = document.getElementById('btn-open-testimonials');
        const btnOpenMobile = document.getElementById('btn-open-testimonials-mobile');
        const modal = document.getElementById('modal-testimonios');
        
        if (!modal) return;

        const backdrop = modal.querySelector('.modal-backdrop-test');
        const content = modal.querySelector('.modal-content-test');

        const openModal = () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            setTimeout(() => {
                backdrop?.classList.replace('opacity-0', 'opacity-100');
                content?.classList.replace('opacity-0', 'opacity-100');
                content?.classList.replace('translate-y-12', 'translate-y-0');
            }, 10);
        };

        const closeModal = () => {
            backdrop?.classList.replace('opacity-100', 'opacity-0');
            content?.classList.replace('opacity-100', 'opacity-0');
            content?.classList.replace('translate-y-0', 'translate-y-12');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }, 500);
        };

        if (btnOpenDesktop) btnOpenDesktop.addEventListener('click', openModal);
        if (btnOpenMobile) btnOpenMobile.addEventListener('click', openModal);

        document.querySelectorAll('.modal-close-test, .modal-backdrop-test').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                closeModal();
            });
        });
    });
</script>