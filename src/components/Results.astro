---
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// 1. Estos 3 testimonios largos quedan FIJOS en la portada para mantener el diseño impecable
const featuredTestimonials = [
  {
    client: "Patricia",
    tag: "Resolución Rápida",
    quote: "Durante el proceso de la resolución del caso me sentí súper acompañada y guiada en cada paso. Recibí la atención y explicación necesaria. Quedé muy contenta con la rápida resolución. Es para recomendar!!",
    date: "Hace 1 semana",
    rating: 5
  },
  {
    client: "Julián",
    tag: "Seguimiento Continuo",
    quote: "Muy contento con el resultado. Todo fue aclarado de la mejor manera, hubo un seguimiento continuo y quedé satisfecho en todos los sentidos, por la atención y los tiempos pactados. Todo fue sin ningún inconveniente.",
    date: "Hace 2 semanas",
    rating: 5
  },
  {
    client: "Marcos T.",
    tag: "Destrucción Total",
    quote: "La aseguradora me daba vueltas para pagarme el valor real del auto. En el estudio tomaron el caso y forzaron el pago de la destrucción total actualizada. Excelente trato humano en un momento de mucho estrés.",
    date: "Hace 1 mes",
    rating: 5
  }
];

// 2. Estos son extra por si la base de datos está vacía, para que el modal no quede pelado
const fallbackExtraTestimonials = [
  {
    client: "Sol Migueles",
    tag: "Caso Complejo",
    quote: "Agradezco al estudio de Abogados MP por la buena atención durante todo el caso, tanto para responder como para resolver todas nuestras inquietudes. Destaco la amabilidad y el buen trato que siempre recibimos. La resolución del caso fue excelente eso que estaba complicado de poder llegar a una pronta resolución. Sin duda los volvería a elegir por su profesionalismo y atención.",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Jose Barros",
    tag: "Claridad y Atención",
    quote: "Buenas tardes, la verdad de 10 la atención, de 10 la claridad de todo. Es para recomendar.",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Christian",
    tag: "Atención Cordial",
    quote: "Hola! Buenas tardes, estoy muy conforme, la atención siempre muy cordial, con la mejor predisposición. Con el resultado también estoy muy conforme. Muchas gracias y los tendré en cuenta por si en el futuro necesito sus servicios.",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Shirly Di Palma",
    tag: "Eficiencia",
    quote: "Sisi muy conforme 🤗 la verdad todo súper rápido, muy profesionales y eficientes. Muchísimas gracias por todo!!!",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Luis Hernán G.",
    tag: "Acompañamiento",
    quote: "Me siento satisfecho con la rapidez que se resolvió. En cuanto al acompañamiento, sentí que siempre estuvieron para mis dudas. Estoy conforme con el resultado. Son muy amables. Gracias.",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Diego Encina",
    tag: "Trámite Rápido",
    quote: "La verdad una exelente atención. Me explicaste muchas cosas y mucha paciencia. La verdad te agradezco muchísimo y te agradezco lo rápido que fue el trámite. Mui contento con tu atención. Muchas gracias..",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Maximiliano V.",
    tag: "Superó Expectativas",
    quote: "La verdad quede muy conforme, las dudas que tuve fueron evacuadas y resultado fue más de lo esperado, muchísimas gracias y me alegra que pueda saber que puedo contar con tu atención 💪🏼",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Daiana Ferraiuolo",
    tag: "Asesoría Completa",
    quote: "Me sentí muy acompañada durante el proceso y asesorada, explicaste todo muy bien! Quede súper contenta con el resultado!🤗",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Leonel Carrillo",
    tag: "Seguridad Legal",
    quote: "La verdad que desde el primer día me sentí muy seguro y acompañado, cualquier duda que tenía me la pudieron explicar, quede muy conforme con el resultado. Muchísimas gracias por su servicio y su amabilidad",
    date: "Reseña Verificada",
    rating: 5
  },
  {
    client: "Juan Canteros",
    tag: "Gestión Exitosa",
    quote: "Buenísimo, muchas gracias por todo sin vos esto no se podía haber solucionado, muchas gracias por tu trabajo",
    date: "Reseña Verificada",
    rating: 5
  }
];

let dbReviews = [];

// 3. Traemos las reseñas cortas/reales de Supabase
try {
    const response = await fetch(`${SUPABASE_URL}/rest/v1/reviews?select=*&order=created_at.desc`, {
        headers: {
            'apikey': SUPABASE_ANON_KEY,
            'Authorization': `Bearer ${SUPABASE_ANON_KEY}`
        }
    });
    
    if (response.ok) {
        dbReviews = await response.json();
    }
} catch (error) {
    console.error("Error cargando reseñas desde Supabase:", error);
}

// 4. Formateamos las de Supabase
const formattedDbReviews = dbReviews.map(r => {
    let dateStr = ""; 
    if (r.created_at) {
        const dateObj = new Date(r.created_at);
        dateStr = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }).format(dateObj);
    }

    return {
        client: r.name,
        tag: r.tag,
        quote: r.quote,
        rating: r.rating || 5,
        date: dateStr
    };
});

// 5. El Modal va a mostrar TODO lo de Supabase, seguido por los testimonios extra de respaldo
const modalTestimonials = [...formattedDbReviews, ...fallbackExtraTestimonials];

// Helper para generar las 5 estrellas
const renderStars = (rating: number) => {
    let html = '';
    for (let i = 1; i <= 5; i++) {
        if (i <= rating) {
            html += `<svg class="w-3 h-3 lg:w-4 lg:h-4 fill-current text-accent" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
        } else {
            html += `<svg class="w-3 h-3 lg:w-4 lg:h-4 fill-current text-slate-800" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
        }
    }
    return html;
};
---
<section id="resultados" class="py-24 md:py-40 px-0 lg:px-8 bg-slate-950 text-white border-t border-slate-900 relative">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
            
            <!-- Columna Izquierda: Cabecera -->
            <div class="lg:col-span-5 lg:sticky lg:top-32 reveal-results px-6 lg:px-0">
                <div class="inline-flex items-center space-x-3 mb-6">
                    <span class="w-8 h-[1px] bg-accent"></span>
                    <span class="text-[10px] md:text-xs font-bold tracking-[0.3em] uppercase text-slate-400">Prueba Social</span>
                </div>
                <h2 class="text-5xl sm:text-6xl lg:text-[5.5rem] font-bold font-serif leading-[0.95] tracking-tighter mb-8 lg:mb-10">
                    Nuestra <br/>
                    <span class="text-slate-400 italic font-light">reputación.</span>
                </h2>
                
                <p class="text-slate-500 font-light text-sm md:text-base leading-relaxed mb-10 lg:mb-12 max-w-sm">
                    No le pedimos que confíe en nuestra palabra, sino en la de aquellos que ya superaron a las aseguradoras gracias a nuestra intervención.
                </p>

                <div class="lg:hidden flex items-center gap-3 text-[10px] font-bold uppercase tracking-widest text-accent mb-8">
                    <svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    <span>Deslizá para leer</span>
                </div>

                <button id="btn-open-testimonials" class="hidden lg:flex group relative justify-center items-center bg-transparent border border-slate-700 text-white px-8 py-5 overflow-hidden rounded-sm transition-all duration-300 w-full sm:w-auto">
                    <span class="relative z-10 text-[10px] font-bold uppercase tracking-[0.2em] group-hover:text-white transition-colors duration-300">
                        Abrir Archivo de Casos
                    </span>
                    <div class="absolute inset-0 bg-slate-800 transform scale-x-0 origin-left group-hover:scale-x-100 transition-transform duration-500 ease-out z-0"></div>
                </button>
            </div>

            <!-- Columna Derecha: Testimonios (Fijos) -->
            <div class="lg:col-span-7 w-full">
                <div class="flex overflow-x-auto lg:flex-col gap-4 lg:gap-24 snap-x snap-mandatory hide-scrollbar px-6 lg:px-0 lg:pl-10 pb-8 lg:pb-0">
                    {featuredTestimonials.map((testimonio, index) => (
