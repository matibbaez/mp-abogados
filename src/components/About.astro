---
// src/components/About.astro
---
<section id="estudio" class="py-24 md:py-32 px-6 lg:px-8 bg-slate-950 text-white relative overflow-hidden border-t border-slate-900/50">
    <!-- <div class="absolute top-1/2 right-0 text-[15rem] lg:text-[25rem] font-serif font-bold text-slate-900/40 select-none pointer-events-none leading-none z-0 -translate-y-1/2 translate-x-1/4">MP</div> -->
    <div class="absolute bottom-0 left-0 w-full h-[500px] bg-accent/5 blur-[150px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
            
            <div class="w-full lg:w-5/12 flex flex-col justify-center reveal-about z-20">
                <div class="inline-flex items-center space-x-3 mb-6">
                    <span class="w-8 h-[1px] bg-accent"></span>
                    <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] text-slate-400 uppercase">Trato y Seguimiento</span>
                </div>
                
                <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif leading-[1.05] tracking-tighter mb-8">
                    Sabés quién lleva tu caso y <br/>
                    <span class="text-slate-400 font-light italic">cómo avanza.</span>
                </h2>
                
                <div class="space-y-6">
                    <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed">
                        Te explicamos cada etapa con palabras claras, te avisamos cuando hay novedades y respondemos tus dudas. Antes de aceptar un acuerdo, conversamos con vos sobre el monto y las condiciones; te explicamos cada propuesta y vos decidís si la aceptás.
                    </p>
                    <p class="text-sm md:text-base text-slate-400 font-light leading-relaxed border-l-2 border-accent pl-4">
                        <strong class="text-white font-medium">Aviso importante:</strong> Si la aseguradora se comunica directamente con vos, avisanos antes de responder una propuesta o firmar documentación. Podemos ayudarte a revisar lo que te ofrecen para defender tus intereses.
                    </p>
                </div>

                <div class="flex lg:hidden grid-cols-2 gap-6 border-t border-slate-800 pt-8 mt-10">
                    <div class="w-1/2">
                        <div class="text-4xl sm:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+5k</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Casos Resueltos</div>
                    </div>
                    <div class="w-1/2">
                        <div class="text-4xl sm:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+10</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Años de Experiencia</div>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-7/12 relative reveal-about" style="transition-delay: 200ms;">
                <div class="w-full aspect-[4/5] lg:aspect-[3/4] bg-slate-900 border border-slate-800 relative group overflow-hidden shadow-2xl rounded-sm z-10">
                    <img src="/maximo.jpeg" alt="Director del Estudio MP Abogados" class="w-full h-full object-cover object-[center_20%] grayscale-[15%] group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-[1.5s] ease-out" onerror="this.src='https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop'" />
                    <div class="absolute inset-0 bg-slate-950/10 group-hover:bg-slate-950/0 transition-colors duration-1000"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent pointer-events-none"></div>
                    <div class="absolute top-8 right-6 vertical-text flex items-center gap-4 opacity-70 group-hover:opacity-100 transition-opacity duration-700">
                        <span class="w-[1px] h-12 bg-accent"></span>
                        <span class="text-[9px] font-bold uppercase tracking-[0.3em] text-white">Dirección Legal</span>
                    </div>
                </div>

                <div class="hidden lg:flex absolute bottom-12 -left-12 xl:-left-24 z-30 bg-slate-900/85 backdrop-blur-xl border border-slate-700 shadow-2xl p-8 items-center gap-10 rounded-sm">
                    <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-accent to-transparent"></div>
                    <div>
                        <div class="text-4xl xl:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+5k</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Casos Resueltos</div>
                    </div>
                    <div class="w-[1px] h-16 bg-slate-700"></div>
                    <div>
                        <div class="text-4xl xl:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+10</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Años de Experiencia</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .vertical-text { writing-mode: vertical-rl; transform: rotate(180deg); }
    .reveal-about { opacity: 0; transform: translateY(40px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal-about.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); }
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal-about').forEach(el => observer.observe(el));
    });
</script>