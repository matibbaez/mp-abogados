---
// src/components/About.astro
---
<section id="estudio" class="py-24 md:py-32 px-6 lg:px-8 bg-slate-950 text-white relative overflow-hidden border-t border-slate-900/50">
    
    <!-- Marca de agua de fondo gigante (Segura)
    <div class="absolute top-1/2 right-0 text-[15rem] lg:text-[25rem] font-serif font-bold text-slate-900/40 select-none pointer-events-none leading-none z-0 -translate-y-1/2 translate-x-1/4">
        MP
    </div> -->

    <!-- Destello de luz sutil -->
    <div class="absolute bottom-0 left-0 w-full h-[500px] bg-accent/5 blur-[150px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        
        <!-- LAYOUT DE COLUMNAS (Súper estable) -->
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
            
            <!-- COLUMNA IZQUIERDA: Textos y Título -->
            <div class="w-full lg:w-5/12 flex flex-col justify-center reveal-about z-20">
                
                <div class="inline-flex items-center space-x-3 mb-6">
                    <span class="w-8 h-[1px] bg-accent"></span>
                    <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] text-slate-400 uppercase">Filosofía de la Firma</span>
                </div>
                
                <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif leading-[1.05] tracking-tighter mb-8">
                    No negociamos <br/>
                    <span class="text-slate-400 font-light italic">con su futuro.</span>
                </h2>
                
                <div class="space-y-6">
                    <p class="text-sm md:text-base text-slate-300 font-light leading-relaxed">
                        Las aseguradoras tienen un solo objetivo: pagarle lo menos posible tras un choque. Conocemos sus tácticas dilatorias y las neutralizamos con peritajes impecables y litigio agresivo.
                    </p>
                    <p class="text-sm md:text-base text-slate-400 font-light leading-relaxed">
                        Detrás de cada siniestro hay una persona lidiando con daños físicos y materiales. Nosotros blindamos sus derechos y forzamos el cumplimiento de las pólizas para que usted solo se enfoque en sanar.
                    </p>
                </div>

                <!-- Métricas Mobile (Solo visibles en celular) -->
                <div class="flex lg:hidden grid-cols-2 gap-6 border-t border-slate-800 pt-8 mt-10">
                    <div class="w-1/2">
                        <div class="text-4xl sm:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+5k</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Casos Resueltos</div>
                    </div>
                    <div class="w-1/2">
                        <div class="text-4xl sm:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">24/7</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Atención Inmediata</div>
                    </div>
                </div>
            </div>

            <!-- COLUMNA DERECHA: Imagen y Tarjeta Flotante -->
            <div class="w-full lg:w-7/12 relative reveal-about" style="transition-delay: 200ms;">
                
                <!-- Contenedor de la Imagen (Mantiene tu aspecto vertical) -->
                <div class="w-full aspect-[4/5] lg:aspect-[3/4] bg-slate-900 border border-slate-800 relative group overflow-hidden shadow-2xl rounded-sm z-10">
                    
                    <img 
                        src="/maximo.jpeg" 
                        alt="Director del Estudio MP Abogados" 
                        class="w-full h-full object-cover object-[center_20%] grayscale-[15%] group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-[1.5s] ease-out"
                        onerror="this.src='https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop'"
                    />
                    
                    <div class="absolute inset-0 bg-slate-950/10 group-hover:bg-slate-950/0 transition-colors duration-1000"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent pointer-events-none"></div>
                    
                    <div class="absolute top-8 right-6 vertical-text flex items-center gap-4 opacity-70 group-hover:opacity-100 transition-opacity duration-700">
                        <span class="w-[1px] h-12 bg-accent"></span>
                        <span class="text-[9px] font-bold uppercase tracking-[0.3em] text-white">Dirección Legal</span>
                    </div>
                </div>

                <!-- Tarjeta Flotante (Solo Desktop) - Rompe la grilla de forma elegante y segura -->
                <div class="hidden lg:flex absolute bottom-12 -left-12 xl:-left-24 z-30 bg-slate-900/85 backdrop-blur-xl border border-slate-700 shadow-2xl p-8 items-center gap-10 rounded-sm">
                    <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-accent to-transparent"></div>
                    
                    <div>
                        <div class="text-4xl xl:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">+5k</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Casos Resueltos</div>
                    </div>
                    
                    <!-- Divisor vertical -->
                    <div class="w-[1px] h-16 bg-slate-700"></div>
                    
                    <div>
                        <div class="text-4xl xl:text-5xl font-bold text-white mb-1 font-serif tracking-tighter">24/7</div>
                        <div class="text-[9px] text-slate-400 uppercase tracking-[0.2em] font-bold">Atención Inmediata</div>
                    </div>
                </div>
                
            </div>

        </div>
    </div>
</section>

<style>
    .vertical-text {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }

    .reveal-about {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-about.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.15 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const elementsToReveal = document.querySelectorAll('.reveal-about');
        elementsToReveal.forEach(el => observer.observe(el));
    });
</script>