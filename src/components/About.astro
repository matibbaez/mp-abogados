---
// src/components/About.astro
---
<section id="estudio" class="py-24 md:py-32 px-6 lg:px-8 bg-slate-900 text-white relative overflow-hidden border-t border-slate-800">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-[300px] bg-accent/5 blur-[120px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-4xl mx-auto relative z-10 text-center">
        
        <div class="inline-flex items-center space-x-3 mb-8 reveal-about">
            <span class="w-12 h-[1px] bg-accent"></span>
            <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] text-slate-400 uppercase">Trato y Seguimiento</span>
            <span class="w-12 h-[1px] bg-accent"></span>
        </div>
        
        <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold font-serif leading-[1.05] tracking-tighter mb-8 reveal-about" style="transition-delay: 100ms;">
            Un equipo que te acompaña <br class="hidden md:block"/>
            <span class="text-slate-400 font-light italic">en cada etapa.</span>
        </h2>
        
        <div class="space-y-6 text-sm md:text-base text-slate-300 font-light leading-relaxed max-w-2xl mx-auto reveal-about" style="transition-delay: 200ms;">
            <p>
                Nuestro estudio está conformado por un equipo de abogados especializados en accidentes de tránsito. Trabajamos en conjunto para analizar tu caso y acompañarte durante todo el reclamo.
            </p>
            <p>
                Te explicamos cada etapa con palabras claras, te mantenemos informado cuando hay novedades y respondemos tus dudas.
            </p>
        </div>

        <!-- Estadísticas integradas -->
        <div class="grid grid-cols-2 gap-8 border-t border-slate-800 pt-16 mt-16 reveal-about" style="transition-delay: 300ms;">
            <div class="flex flex-col items-center">
                <div class="text-5xl md:text-7xl font-bold text-white mb-2 font-serif tracking-tighter">+5k</div>
                <div class="text-[9px] md:text-xs text-slate-400 uppercase tracking-[0.2em] font-bold">Casos Resueltos</div>
            </div>
            <div class="flex flex-col items-center">
                <div class="text-5xl md:text-7xl font-bold text-white mb-2 font-serif tracking-tighter">+10</div>
                <div class="text-[9px] md:text-xs text-slate-400 uppercase tracking-[0.2em] font-bold">Años de Experiencia</div>
            </div>
        </div>

    </div>
</section>

<style>
    .reveal-about { opacity: 0; transform: translateY(40px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal-about.is-visible { opacity: 1; transform: translateY(0); }
</style>
<script>
    document.addEventListener('astro:page-load', () => {
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) { entry.target.classList.add('is-visible'); obs.unobserve(entry.target); }
            });
        }, { threshold: 0.15 });
        document.querySelectorAll('.reveal-about').forEach(el => observer.observe(el));
    });
</script>