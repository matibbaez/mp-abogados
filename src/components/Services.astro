---
const services = [
  {
    number: "01",
    title: "Siniestros Viales",
    description: "Representación exclusiva para víctimas de accidentes en moto, auto, bicicleta o como peatón. Reclamamos el resarcimiento económico total por daños materiales, lesiones físicas y daño moral.",
    icon: `<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>`
  },
  {
    number: "02",
    title: "Plataformas y Pasajeros",
    description: "Litigios complejos que involucran vehículos de aplicaciones (Uber, Cabify, Didi) y transporte público. Protegemos tanto a conductores como a pasajeros frente a los vacíos legales de las pólizas.",
    icon: `<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`
  },
  {
    number: "03",
    title: "Frente a las Aseguradoras",
    description: "Neutralizamos las tácticas de desgaste. Desde la pelea por la destrucción total y el valor real en el mercado, hasta indemnizaciones por incapacidad sobreviniente. Nunca aceptamos la primera oferta.",
    icon: `<svg class="w-6 h-6 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`
  }
];
---
<section id="servicios" class="py-20 md:py-32 px-6 lg:px-8 bg-slate-50 text-slate-950 overflow-hidden">
    <div class="max-w-7xl mx-auto">
        
        <!-- Cabecera Editorial -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 md:mb-24 gap-8 reveal-on-scroll">
            <div class="max-w-3xl">
                <div class="inline-flex items-center space-x-3 mb-6 md:mb-8">
                    <span class="w-12 h-[1px] bg-accent"></span>
                    <span class="text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-slate-500">Dominio Técnico</span>
                </div>
                <h2 class="text-4xl sm:text-5xl md:text-7xl font-bold font-serif tracking-tighter leading-[1.05]">
                    Especialización <br/>
                    <span class="text-slate-400 italic font-light">sin distracciones.</span>
                </h2>
            </div>
            <div class="max-w-sm pb-2">
                <p class="text-slate-500 font-medium text-sm md:text-base leading-relaxed hidden md:block border-l-2 border-slate-200 pl-4">
                    Enfocamos todos nuestros recursos en el derecho de daños y siniestros viales para asegurar una representación legal implacable.
                </p>
            </div>
        </div>

        <!-- Lista de Servicios -->
        <div class="border-t border-slate-200">
            {services.map((service, index) => (
                <div class="group relative flex flex-col lg:flex-row items-start lg:items-center py-10 md:py-16 border-b border-slate-200 hover:bg-white hover:shadow-sm transition-all duration-500 px-4 md:px-8 -mx-4 md:-mx-8 reveal-on-scroll" style={`transition-delay: ${index * 150}ms;`}>
                    
                    <!-- Número (Cambia al azul de la marca en hover) -->
                    <div class="text-4xl md:text-6xl font-serif text-slate-200 group-hover:text-accent transition-colors duration-500 w-24 md:w-32 shrink-0 mb-4 lg:mb-0">
                        {service.number}.
                    </div>
                    
                    <!-- Título e Icono -->
                    <div class="flex-grow lg:w-1/3 mb-4 lg:mb-0 pr-0 lg:pr-8">
                        <div class="flex items-center gap-4 mb-3 text-slate-300 group-hover:text-accent transition-colors duration-500">
                            <div set:html={service.icon} />
                        </div>
                        <h3 class="text-2xl md:text-4xl font-bold font-serif tracking-tight text-slate-950">
                            {service.title}
                        </h3>
                    </div>
                    
                    <!-- Descripción y Botón Circular -->
                    <div class="lg:w-1/2 flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-12">
                        <p class="text-slate-500 text-sm md:text-base font-medium leading-relaxed flex-grow group-hover:text-slate-700 transition-colors duration-500">
                            {service.description}
                        </p>
                        <!-- Botón de acción con flecha a 45 grados (Premium y ahora en Azul) -->
                        <a href="#contacto" class="shrink-0 w-12 h-12 rounded-full border border-slate-300 flex items-center justify-center text-slate-400 group-hover:bg-accent group-hover:border-accent group-hover:text-white transition-all duration-500 transform group-hover:scale-110 group-hover:rotate-45">
                            <svg class="w-5 h-5 -rotate-45 group-hover:rotate-0 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                        </a>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.15
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const elementsToReveal = document.querySelectorAll('.reveal-on-scroll');
        elementsToReveal.forEach(el => observer.observe(el));
    });
</script>