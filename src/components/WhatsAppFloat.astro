---
// Pestaña lateral flotante de WhatsApp minimalista
const whatsappUrl = "https://wa.me/5491168809555"; // Reemplazar con el número real
---

<!-- Versión Desktop: Pestaña lateral que se asoma a la mitad de la pantalla -->
<div class="fixed right-0 top-1/2 -translate-y-1/2 z-50 hidden md:flex items-center">
    <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Contacto por WhatsApp"
        class="group relative flex items-center bg-slate-950/95 backdrop-blur-xl border-y border-l border-slate-700/50 hover:border-slate-500 rounded-l-sm shadow-2xl transition-transform duration-500 ease-out transform translate-x-[calc(100%-3.5rem)] hover:translate-x-0"
    >
        <!-- Contenedor interno -->
        <div class="flex items-center pl-4 pr-6 py-4 gap-4">
            
            <!-- Ícono (Siempre visible en la parte izquierda) -->
            <div class="relative flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-emerald-400 group-hover:text-emerald-300 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <!-- Punto de pulso para incitar la interacción -->
                <span class="absolute -top-1 -right-1 w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
            </div>

            <!-- Texto (Oculto a la derecha, se revela al deslizar) -->
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-white whitespace-nowrap">
                WhatsApp Directo
            </span>
            
        </div>
    </a>
</div>

<!-- Versión Mobile: Pestaña lateral (Estilo Desktop, asomando desde el borde) -->
<div class="fixed right-0 top-[65%] -translate-y-1/2 z-50 md:hidden flex items-center">
    <a 
        href={whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        aria-label="Contacto por WhatsApp"
        class="relative flex items-center bg-slate-950/95 backdrop-blur-xl border-y border-l border-slate-700/50 py-3 pl-3 pr-2.5 rounded-l-sm shadow-[0_0_20px_rgba(0,0,0,0.5)] active:bg-slate-900 transition-colors"
    >
        <div class="relative flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <!-- Punto de pulso (clave visual para incitar a tocar) -->
            <span class="absolute -top-1 -right-1 w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        </div>
    </a>
</div>